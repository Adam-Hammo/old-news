# Pulumi.<stack>.yaml is committed, not ignored — `secure:` values are ciphertext
# only the stack's Pulumi Cloud key can read, and CI cannot select a stack it has
# no config for.
config:
  oci:region: ap-sydney-1
  old-news:compartmentOcid: ocid1.tenancy.oc1..xxxxx
  old-news:availabilityDomain: xxxx:AP-SYDNEY-1-AD-1
  old-news:sshPublicKey: ssh-ed25519 AAAA... you@host
  # Pin the exact image the instance runs. Do not resolve this dynamically.
  old-news:imageOcid: ocid1.image.oc1.ap-sydney-1.xxxxx
  old-news:ocpus: "2"
  old-news:memoryGb: "12"
  old-news:bootVolumeGb: "200"
  old-news:publicSshEnabled: "true"
  old-news:b2Bucket: your-globally-unique-bucket-name
  old-news:b2Region: us-west-004
  old-news:logfireProject: old-news
  # Set every secret with `pulumi config set --secret`, never by editing this file:
  # heartbeatUrl, budgetAlertRecipient, b2:applicationKeyId, b2:applicationKey,
  # logfire:apiKey, healthchecksio:apiKey, tailscale:oauthClientId,
  # tailscale:oauthClientSecret. Plus tailscale:tailnet, which is not secret.
  #
  # heartbeatUrl and logfireAlertWebhook are only needed without healthchecksio:apiKey
  # — with it, both checks are created here and their URLs wired up directly.
