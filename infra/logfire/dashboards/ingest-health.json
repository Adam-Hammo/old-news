{
  "kind": "Dashboard",
  "metadata": {
    "name": "Ingest health",
    "project": "old-news"
  },
  "spec": {
    "display": {
      "name": "Ingest health",
      "description": "Whether feeds are being polled, how fast, and which ones are failing."
    },
    "panels": {
      "poll_outcomes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Poll outcomes",
            "description": "not_modified dominating is the feeds behaving; failed climbing is not."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "show": true,
                "min": 0,
                "label": "Events"
              },
              "visual": {
                "display": "line",
                "areaOpacity": 0.25
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "LogfireTimeSeriesQuery",
                  "spec": {
                    "query": "SELECT time_bucket($resolution, recorded_timestamp) AS time,\n       replace(metric_name, 'ingest.', '') AS series,\n       SUM(metric_sum(value)) AS events\nFROM metrics\nWHERE metric_name IN ('ingest.polls.not_modified',\n                      'ingest.polls.failed',\n                      'ingest.items.new',\n                      'ingest.items.edited')\n  AND recorded_timestamp < time_bucket($resolution, now())\nGROUP BY time, series\nORDER BY time DESC;",
                    "groupBy": "series",
                    "metrics": ["events"]
                  }
                }
              }
            }
          ]
        }
      },
      "poll_duration": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Poll duration",
            "description": "Average against worst: a slow feed hides in the mean."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "show": true,
                "min": 0,
                "format": {
                  "unit": "seconds",
                  "decimalPlaces": 2
                }
              },
              "visual": {
                "display": "line",
                "areaOpacity": 0.25
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "LogfireTimeSeriesQuery",
                  "spec": {
                    "query": "SELECT time_bucket($resolution, start_timestamp) AS time,\n       AVG(duration) AS avg_seconds,\n       MAX(duration) AS max_seconds\nFROM records\nWHERE span_name = 'poll feed'\n  AND start_timestamp < time_bucket($resolution, now())\nGROUP BY time\nORDER BY time DESC;",
                    "groupBy": "",
                    "metrics": ["avg_seconds", "max_seconds"]
                  }
                }
              }
            }
          ]
        }
      },
      "http_status": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Feed HTTP status"
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "query": ""
            }
          },
          "queries": [
            {
              "kind": "NonTimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "LogfireNonTimeSeriesQuery",
                  "spec": {
                    "query": "SELECT attributes->>'http.response.status_code' AS status,\n       count(*) AS requests\nFROM records\nWHERE span_name = 'GET feed'\nGROUP BY status\nORDER BY requests DESC;"
                  }
                }
              }
            }
          ]
        }
      },
      "slowest_feeds": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Slowest feeds"
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "query": ""
            }
          },
          "queries": [
            {
              "kind": "NonTimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "LogfireNonTimeSeriesQuery",
                  "spec": {
                    "query": "SELECT attributes->>'feed.id' AS feed,\n       count(*) AS polls,\n       avg(duration) AS avg_seconds,\n       max(duration) AS max_seconds\nFROM records\nWHERE span_name = 'poll feed'\nGROUP BY feed\nORDER BY max_seconds DESC\nLIMIT 20;"
                  }
                }
              }
            }
          ]
        }
      },
      "failing_feeds": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Feeds failing most"
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "query": ""
            }
          },
          "queries": [
            {
              "kind": "NonTimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "LogfireNonTimeSeriesQuery",
                  "spec": {
                    "query": "SELECT attributes->>'feed' AS feed,\n       SUM(metric_sum(value)) AS failures\nFROM metrics\nWHERE metric_name = 'ingest.polls.failed'\nGROUP BY feed\nORDER BY failures DESC\nLIMIT 20;"
                  }
                }
              }
            }
          ]
        }
      },
      "suspensions": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Suspended feeds",
            "description": "Silent data loss otherwise: nothing else says a feed stopped being read."
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "query": ""
            }
          },
          "queries": [
            {
              "kind": "NonTimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "LogfireNonTimeSeriesQuery",
                  "spec": {
                    "query": "SELECT start_timestamp, message\nFROM records\nWHERE level >= 'warn' AND message LIKE 'suspending feed%'\nORDER BY start_timestamp DESC\nLIMIT 50;"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Polling",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/poll_outcomes"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/poll_duration"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/http_status"
              }
            },
            {
              "x": 12,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/slowest_feeds"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Failures",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/failing_feeds"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/suspensions"
              }
            }
          ]
        }
      }
    ],
    "variables": [],
    "duration": "6h",
    "refreshInterval": "0s",
    "datasources": {}
  }
}
