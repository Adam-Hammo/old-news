OLD_NEWS_ENVIRONMENT=production
POSTGRES_PASSWORD={{ postgres_password }}

# Tailnet only — never 0.0.0.0.
APP_BIND={{ app_bind }}
API_HOST_PORT={{ api_host_port }}

OLD_NEWS_ADMIN__PASSWORD_HASH={{ admin_password_hash }}

OLD_NEWS_TELEMETRY__ENABLED={{ telemetry_enabled | default('false') }}
OLD_NEWS_TELEMETRY__LOGFIRE_TOKEN={{ logfire_token | default('') }}
OLD_NEWS_TELEMETRY__SYSTEM_METRICS={{ telemetry_system_metrics | default('false') }}
OLD_NEWS_TELEMETRY__INSTRUMENT_DATABASE={{ telemetry_instrument_database | default('false') }}

# 12 GB box. Also keeps memory utilisation over Oracle's 20% reclamation
# threshold.
PG_SHARED_BUFFERS=3GB
PG_EFFECTIVE_CACHE_SIZE=9GB
PG_MAINTENANCE_WORK_MEM=512MB

REGISTRY={{ registry }}
IMAGE_TAG={{ image_tag }}

# restic -> Backblaze B2. The backup scripts only read RESTIC_REPOSITORY, so this
# is the single line that differs from a local test run.
RESTIC_REPOSITORY=s3:s3.{{ b2_region }}.backblazeb2.com/{{ b2_bucket }}
RESTIC_PASSWORD={{ restic_password }}
B2_KEY_ID={{ b2_key_id }}
B2_APPLICATION_KEY={{ b2_application_key }}
