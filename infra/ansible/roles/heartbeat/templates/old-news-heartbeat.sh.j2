#!/usr/bin/env bash
# Pinging unconditionally would only prove the kernel is alive.
set -uo pipefail

source /etc/old-news/heartbeat.env

if curl -fsS --max-time 10 "http://{{ app_bind }}:{{ api_host_port }}/health/ready" >/dev/null 2>&1; then
  curl -fsS -m 10 --retry 3 "$HEARTBEAT_URL" >/dev/null 2>&1
else
  # Signal it rather than waiting out the grace period on a missed ping.
  curl -fsS -m 10 --retry 3 "$HEARTBEAT_URL/fail" >/dev/null 2>&1
  exit 1
fi
