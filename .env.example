# Copy to .env. Everything is OLD_NEWS_-prefixed; nested keys use __.

OLD_NEWS_ENVIRONMENT=local
# 1605 is the year the first newspaper was printed, and nothing else wants this block.
# It also sits below the ephemeral range on both Linux (32768+) and macOS (49152+),
# which is more than the old 55432 could say.
#
#   16051  api        16053  vite dev server
#   16052  web        16054  postgres
PG_HOST_PORT=16054
OLD_NEWS_DATABASE__URL=postgres://old_news:old_news@localhost:16054/old_news

OLD_NEWS_API__DEBUG=true

# Off by default so the app runs with no account. Set a token to start shipping spans.
OLD_NEWS_TELEMETRY__ENABLED=false
# OLD_NEWS_TELEMETRY__LOGFIRE_TOKEN=
OLD_NEWS_TELEMETRY__CONSOLE=false
# One span per SQL query. Turn on while chasing a slow query, off the rest of the
# time — it is roughly 3x the span volume on its own.
OLD_NEWS_TELEMETRY__INSTRUMENT_DATABASE=false

# Postgres tuning is fetched from api.pgconfig.org at first start, sized from the
# container's own memory and CPU count. These are the only levers.
PG_TUNING_ENVIRONMENT=WEB
PG_TUNING_DRIVE_TYPE=SSD
# Set to 1 to initialise without the API. Fallback sizing, loudly warned about.
# PG_TUNING_OFFLINE=1

POSTGRES_PASSWORD=old_news

# Container memory caps. The worker is the one that runs extraction and embedding.
APP_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=2g

# Loopback in production too: Tailscale Serve fronts the API and terminates TLS.
APP_BIND=127.0.0.1
API_HOST_PORT=16051
WEB_HOST_PORT=16052

# What `just serve` binds when it runs the API on the host instead of in compose.
OLD_NEWS_API__PORT=16051

# Admin is full CRUD over the archive and must never be publicly reachable.
# Seeded credentials, no registration endpoint.
OLD_NEWS_ADMIN__ENABLED=true
OLD_NEWS_ADMIN__USERNAME=admin
# A scrypt hash, not a password: `just admin-password` prints this line. Unset
# falls back to the development password locally, and refuses to start in
# production.
# OLD_NEWS_ADMIN__PASSWORD_HASH=
# Unset regenerates per process, logging sessions out on restart.
# OLD_NEWS_ADMIN__SESSION_SECRET=

# Polling. Feed-declared <ttl> is honoured as a floor, never to poll more often.
OLD_NEWS_INGEST__DEFAULT_INTERVAL_SECONDS=1800
OLD_NEWS_INGEST__MIN_INTERVAL_SECONDS=300
OLD_NEWS_INGEST__MAX_INTERVAL_SECONDS=86400
OLD_NEWS_INGEST__POLL_BATCH_SIZE=50
