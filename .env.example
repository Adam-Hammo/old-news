# Copy to .env. Everything is OLD_NEWS_-prefixed; nested keys use __.

OLD_NEWS_ENVIRONMENT=local
# 55432, not 5432 — compose deliberately avoids colliding with a local Postgres.
PG_HOST_PORT=55432
OLD_NEWS_DATABASE__URL=postgres://old_news:old_news@localhost:55432/old_news

OLD_NEWS_API__DEBUG=true

# Off by default so the app runs with no account. Set a token to start shipping spans.
OLD_NEWS_TELEMETRY__ENABLED=false
# OLD_NEWS_TELEMETRY__LOGFIRE_TOKEN=
OLD_NEWS_TELEMETRY__CONSOLE=false
# One span per SQL query. Turn on while chasing a slow query, off the rest of the
# time — it is roughly 3x the span volume on its own.
OLD_NEWS_TELEMETRY__INSTRUMENT_DATABASE=false

# Postgres tuning is fetched from api.pgconfig.org at first start, sized from the
# container's own memory and CPU count. These are the only levers.
PG_TUNING_ENVIRONMENT=WEB
PG_TUNING_DRIVE_TYPE=SSD
# Set to 1 to initialise without the API. Fallback sizing, loudly warned about.
# PG_TUNING_OFFLINE=1

POSTGRES_PASSWORD=old_news

# Container memory caps. The worker is the one that runs extraction and embedding.
APP_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=2g

# Bind the API to the tailnet interface in production, not 0.0.0.0.
APP_BIND=127.0.0.1
API_HOST_PORT=8000
