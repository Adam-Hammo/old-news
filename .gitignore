.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

.env
var/
# Your reading list is yours. local/ is the place to keep it, and an .opml
# anywhere else is ignored too so a stray export can't be committed by accident.
/local/*
!/local/README.md
*.opml

launch.log

# Pulumi.<stack>.yaml is committed. Its `secure:` values are ciphertext that only
# the stack's Pulumi Cloud key can read, and CI cannot select a stack it has no
# config for. Only local state and backups stay out.
infra/.pulumi/
infra/Pulumi.*.yaml.bak
